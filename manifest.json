{
  "manifest_version": 3,
  "name": "Page Voice - TTS Reader",
  "version": "1.0",
  "description": "Reads the content of the current page with text highlighting.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/content.js"]
    }
  ]
}
